# TODO: obtain pam modules needed for su from pam module search path

bin attr
bin awk
bin basename
bin bc
bin blkdiscard
bin blkid
bin blockdev
bin cat
bin chacl
bin chattr
bin chgrp
bin chmod
bin chown
bin cmp
bin cp
bin cut
bin date
bin dd
bin df
bin diff
bin dirname
bin dmesg
bin du
bin e2fsck
bin egrep
bin expr
bin fallocate
bin false
bin fgrep
bin filefrag
bin find
bin findmnt
bin flock
bin free
bin fsck
bin fstrim
bin getconf
bin getfacl
bin getfattr
bin getopt
bin grep
bin gzip
bin head
bin hexdump
bin hostname
bin id
bin ip
bin ipcmk
bin ipcrm
bin ipcs
bin kill
bin killall
bin link
bin ln
bin logger
bin losetup
bin ls
bin lsattr
bin md5sum
bin mkdir
bin mkfifo
bin mkfs
bin mknod
bin mkswap
bin mktemp
bin mv
bin od
bin perl
bin pgrep
bin ps
bin pvremove
bin quota
bin quotacheck
bin quotaon
bin readlink
bin realpath
bin repquota
bin rev
bin rm
bin rmdir
bin sed
bin seq
bin setfacl
bin setfattr
bin setquota
bin sha256sum
bin shuf
bin sleep
bin sort
bin stat
bin strace
bin su
bin swapoff
bin swapon
bin sync
bin sysctl
bin tac
bin tail
bin tar
bin tee
bin timeout
bin touch
bin tr
bin truncate
bin tune2fs
bin umount
bin uname
bin uniq
bin unlink
bin unshare
bin vgremove
bin wc
bin which
bin wipefs
bin xargs
bin xfs_db
bin xfs_freeze
bin xfs_io
bin xfs_mkfile
bin yes

# udev needed for dm devices
bin dmsetup
bin udevadm
bin systemd-udevd
# systemd-udevd needs /run to exist for /run/udev creation
dir /run
# TODO: we should only need dm rules - generate on boot?
tree /usr/lib/udev/rules.d /usr/lib/udev/rules.d

# rapido-cut adds bash by default, but xfstests hardcodes /bin/bash so make
# sure we have it there (as a symlink)
bin /bin/bash
# /bin/sh is also used
slink /bin/sh /bin/bash
# btrfs/058 calls xfs_io interactively; silence "Cannot read termcap database"
try-bin /usr/share/terminfo/l/linux
# xfstests hardcoded
bin /bin/true

try-bin dbench
try-bin /usr/share/dbench/client.txt
try-bin duperemove
try-bin fsverity
try-bin keyctl
try-bin openssl
try-bin /etc/ssl/openssl.cnf
try-bin nano
try-bin fio
try-bin setcap
try-bin getcap
try-bin capsh

filter ${FSTESTS_SRC}/.git
bin ${FSTESTS_SRC}

# _fstests_devs_provision() uses zram by default...
kmod zram
kmod lzo
kmod lzo_rle
# only needed if passing through devs instead of zram...
try-kmod virtio_blk

try-kmod loop
try-kmod dm-snapshot
try-kmod dm-thin-pool
try-kmod dm-zero
try-kmod dm-delay
try-kmod dm-flakey
try-kmod dm-log-writes
try-kmod scsi_debug

# fstype specific kernel modules (xfs.ko, btrfs.ko, etc.) aren't listed as
# generic dependencies in this manifest.
